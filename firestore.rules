rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Delegated lists: anyone with the secret link can read and tick items; only the owner manages them.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'updatedAt']);
    }
  }
}
